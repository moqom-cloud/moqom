#cloud-config

write_files:
  - path: /etc/sysctl.d/60-moqom-relay.conf
    permissions: "0644"
    owner: root
    content: |
      # QUIC does its loss recovery, pacing, and congestion control in
      # userspace, so the kernel's only job on the receive path is to not lose
      # datagrams between the NIC and the socket. The Container-Optimized OS
      # defaults are sized for a handful of TCP flows; a relay handles small
      # packets at a high rate from thousands of peers, and the first symptom of
      # an undersized receive buffer is packet loss that the sender interprets
      # as congestion and responds to by sending less.
      net.core.rmem_max = 33554432
      net.core.wmem_max = 33554432
      net.core.rmem_default = 8388608
      net.core.wmem_default = 8388608
      net.core.netdev_max_backlog = 65536
      net.core.somaxconn = 8192

      # The relay runs as an unprivileged user in a container that shares this
      # host's network namespace, and it has to bind 443 -- which the kernel
      # reserves for root. The alternatives are worse: running the relay as root
      # to bind one socket, or a redirect from 4443 that adds a hop to every
      # datagram on a machine whose entire job is forwarding datagrams. These
      # VMs run one workload and nothing else listens here, so the reservation
      # protects nothing.
      net.ipv4.ip_unprivileged_port_start = 0

      # UDP memory accounting in pages, not bytes.
      net.ipv4.udp_mem = 262144 524288 1048576
      net.ipv4.udp_rmem_min = 262144
      net.ipv4.udp_wmem_min = 262144

  - path: /etc/chrony/chrony.conf
    permissions: "0644"
    owner: root
    content: |
      # Replaces the Container-Optimized OS default wholesale, and the word
      # "replaces" is the point rather than an implementation detail.
      #
      # COS ships `server metadata.google.internal prefer iburst`, and Google's
      # metadata clock *smears* leap seconds: it spreads the extra second across
      # a long window so that UTC never repeats. Cloudflare does not smear — it
      # forwards the leap indicator and lets the kernel step — and Cloudflare's
      # own documentation warns that mixing smeared and unsmeared sources gives
      # "unpredictable and anomalous results". Since every MOQOM client takes its
      # time from time.cloudflare.com, a relay left on the metadata server would
      # sit up to half a second away from the phones publishing to it for the
      # duration of a smear, which is far worse than the one-second
      # discontinuity the smear exists to avoid.
      #
      # So: one source family, chosen to match the clients, and the Google
      # source removed rather than deprioritised.
      #
      # `maxpoll 6` pins the poll interval at 64 seconds instead of letting
      # chrony back a stable clock off to its default 1024, and the number comes
      # from the frame rate. The kernel's error bound is not a measurement of
      # drift; it grows at the kernel's own tolerance of 500ppm between
      # corrections, whatever the crystal is really doing. So the peak bound is
      # simply the poll interval times that: 64s gives 32ms, which is inside one
      # frame at 30fps, and the default 1024s would give 512ms — five times the
      # ceiling this relay stamps against, so most of every cycle would be
      # reported as untrusted by a clock that was in fact fine.
      #
      # A frame is the right unit because frames are what these timecodes order.
      # A bound wider than the gap between two of them cannot say which of two
      # phones' frames was captured first, which is the entire question a
      # timecode on media exists to answer. Four packets a minute per relay is
      # what that costs.
      pool time.cloudflare.com iburst maxsources 4 maxpoll 6

      # Step rather than slew for the first few updates, then slew forever
      # after. A relay that boots with a wildly wrong clock should correct it
      # immediately; one that has been serving for a week should never have time
      # jump underneath an in-flight recording.
      makestep 1.0 3

      # Never smear. This is chrony's default, and it is written down because
      # the alternative — `leapsecmode slew` — would silently reintroduce
      # exactly the mismatch this file exists to remove.
      #
      # Worth being explicit that not smearing is the *better* choice here and
      # not merely the consistent one, because the usual advice says otherwise.
      # Smearing keeps the wall clock continuous, which protects code that
      # computes durations from it; every famous leap-second outage was a
      # negative duration. MOQOM has no such code — every duration in the relay,
      # the control plane and the SDKs comes from a monotonic clock, never from
      # this one — so smearing would buy protection we do not need.
      #
      # What it would cost is the thing we cannot give up. A smearing host is
      # knowingly up to half a second from UTC for around twenty-four hours,
      # and the kernel reports a healthy few-millisecond error bound throughout,
      # so the relay would publish confident timecodes that are wrong by 500ms
      # with nothing anywhere to indicate it. Not smearing gives a one-second
      # window instead of a day-long one, and it announces itself in advance via
      # the leap indicator, which the relay turns into a ±1s uncertainty on
      # every timecode for the rest of that day. Honest and short beats silent
      # and long, for a system whose whole premise is the error bound.
      leapsecmode system

      # Refuse a source whose own root distance is worse than this. The relay
      # publishes the kernel's error bound as the uncertainty on every timecode
      # it writes, so a source that cannot say where it is within a quarter
      # second is worse than no source: it would produce confident-looking
      # readings with no basis.
      maxdistance 0.25

      driftfile /var/lib/chrony/drift
      rtcsync
      logdir /var/log/chrony

  - path: /etc/moqom/open-ports.sh
    permissions: "0700"
    owner: root
    content: |
      #!/bin/bash
      # Open the relay's ports in the host firewall.
      #
      # Container-Optimized OS boots with `-P INPUT DROP` and allows almost
      # nothing: loopback, ICMP, established flows, and SSH. A VPC firewall rule
      # is therefore necessary and not sufficient -- the packet is permitted onto
      # the wire and then dropped by the machine it was addressed to. The health
      # check reports "Timeout waiting for connect" against a process that is
      # listening and answers the same request locally, and media on UDP/443
      # would fail the same way with no log line anywhere to say so.
      #
      # Run from the relay unit rather than once at first boot, so a reboot
      # cannot leave the rules behind: iptables state does not survive one, and
      # cloud-init's runcmd does not run again.
      set -eu

      open() {
          local protocol="$1" port="$2"
          # -C tests for the rule and fails if it is absent, which makes this
          # safe to run on every start.
          iptables -C INPUT -p "$protocol" --dport "$port" -j ACCEPT 2>/dev/null ||
              iptables -A INPUT -p "$protocol" --dport "$port" -j ACCEPT
          ip6tables -C INPUT -p "$protocol" --dport "$port" -j ACCEPT 2>/dev/null ||
              ip6tables -A INPUT -p "$protocol" --dport "$port" -j ACCEPT
      }

      # Media, from anywhere. Who may reach it is the VPC firewall's decision.
      open udp ${udp_port}
%{ if stun_port != "" ~}

      # STUN, from anywhere, for the same reason.
      open udp ${stun_port}
%{ endif ~}

      # The probe port. Left open at the host and narrowed to Google's prober
      # ranges by the VPC rule, so there is one place that decides who may ask a
      # relay whether it is well.
      open tcp ${health_check_port}

  # /etc, not /opt. Container-Optimized OS mounts its root read-only under
  # dm-verity and only a few trees are writable; a write_files entry under /opt
  # fails, and it takes the rest of the list with it -- which presents as a
  # missing systemd unit rather than as a permissions error.
  - path: /etc/moqom/fetch-secrets.sh
    permissions: "0700"
    owner: root
    content: |
      #!/bin/bash
      # Fetch the relay's secrets from Secret Manager into tmpfs.
      #
      # Into /run rather than /etc because /run is tmpfs: the private key and the
      # control-plane credential never touch the boot disk, so a snapshot of it
      # holds neither. They are re-fetched on every start, which also means
      # rotating one is a rolling restart rather than a rebuild.
      #
      # curl and the metadata server rather than gcloud: the Container-Optimized
      # OS image has no SDK, and pulling one to read three strings would be a
      # container start on the critical path of every boot.
      set -euo pipefail

      mkdir -p /run/moqom/tls
      chmod 0755 /run/moqom

      token() {
          curl -sf -H "Metadata-Flavor: Google" \
              "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" \
              | sed -n 's/.*"access_token":"\([^"]*\)".*/\1/p'
      }

      TOKEN="$(token)"
      if [ -z "$TOKEN" ]; then
          echo "no access token from the metadata server" >&2
          exit 1
      fi

      # The response is pretty-printed JSON, so the payload is on its own line.
      # `"data": "` does not match the `"dataCrc32c"` line beside it.
      fetch() {
          curl -sf -H "Authorization: Bearer $TOKEN" \
              "https://secretmanager.googleapis.com/v1/projects/${project_id}/secrets/$1/versions/latest:access" \
              | sed -n 's/.*"data": "\([^"]*\)".*/\1/p' \
              | base64 -d
      }

%{ if tls_certificate_secret_id != "" ~}
      fetch "${tls_certificate_secret_id}" > /run/moqom/tls/cert.pem
      fetch "${tls_private_key_secret_id}" > /run/moqom/tls/key.pem
      # The container runs as the distroless nonroot user, which is this uid.
      # Root-owned files it cannot read would present as a relay that starts and
      # then exits complaining about its certificate.
      chown ${container_uid}:${container_uid} /run/moqom/tls/cert.pem /run/moqom/tls/key.pem
      chmod 0444 /run/moqom/tls/cert.pem
      chmod 0400 /run/moqom/tls/key.pem
%{ endif ~}
%{ if link_ca_secret_id != "" ~}

      # The link's certificates, which answer a different question from the two
      # above. Those prove this relay to a phone. These prove it to the control
      # plane, and -- the direction that matters -- prove the control plane to
      # it: what arrives over that stream includes the keys every session on
      # this machine is authenticated against.
      mkdir -p /run/moqom/link
      fetch "${link_ca_secret_id}" > /run/moqom/link/ca.pem
      fetch "${link_client_cert_secret_id}" > /run/moqom/link/cert.pem
      fetch "${link_client_key_secret_id}" > /run/moqom/link/key.pem
      chown -R ${container_uid}:${container_uid} /run/moqom/link
      chmod 0444 /run/moqom/link/ca.pem /run/moqom/link/cert.pem
      chmod 0400 /run/moqom/link/key.pem
%{ endif ~}
%{ if ticket_keys_secret_id != "" ~}

      # The fleet's direct-ticket signing keys. Private halves included, so
      # tmpfs and owner-only like the TLS key.
      mkdir -p /run/moqom/tickets
      fetch "${ticket_keys_secret_id}" > /run/moqom/tickets/keys.json
      chown -R ${container_uid}:${container_uid} /run/moqom/tickets
      chmod 0400 /run/moqom/tickets/keys.json
%{ endif ~}

      # An env file rather than `--env` on the command line, because a systemd
      # unit is world-readable and `docker inspect` is not privileged. This is
      # 0600 and root-owned; the daemon reads it, the container never sees the
      # file.
      umask 077
      : > /run/moqom/relay.env
%{ if credential_secret_id != "" ~}
      printf 'MOQOM_CONTROL_CREDENTIAL=%s\n' "$(fetch "${credential_secret_id}")" >> /run/moqom/relay.env
%{ endif ~}
      chmod 0600 /run/moqom/relay.env

%{ if ziti_enabled ~}
  - path: /etc/moqom/ziti-enroll.sh
    permissions: "0700"
    owner: root
    content: |
      #!/bin/bash
      # Enrol this machine on the management overlay, once per instance.
      #
      # The control plane mints the identity, named after this instance,
      # against two proofs: the fleet's relay credential, and an identity token
      # only this VM's metadata server can produce, signed by Google and minted
      # for the control plane's audience. Neither alone mints anything. The
      # enrolled file lives on the boot disk so a reboot keeps it; a recreated
      # instance has a new disk and asks again, and the control plane deletes
      # the identity of an instance that is gone.
      set -euo pipefail

      DIR=/var/lib/moqom-ziti
      WORK=/run/moqom-ziti
      if [ -s "$DIR/identity.json" ]; then
          exit 0
      fi
      mkdir -p "$DIR" "$WORK"
      chmod 0700 "$DIR" "$WORK"
      umask 077

      # Bounded, so a control plane that is down fails this attempt and
      # systemd tries again later rather than the unit hanging in start.
      request() { curl -sS --fail --max-time 30 --retry 3 --retry-connrefused "$@"; }
      metadata() {
          request -H "Metadata-Flavor: Google" "http://metadata.google.internal/computeMetadata/v1/$1"
      }
      ACCESS="$(metadata instance/service-accounts/default/token | sed -n 's/.*"access_token":"\([^"]*\)".*/\1/p')"
      printf 'Authorization: Bearer %s\n' "$ACCESS" > "$WORK/gcp.hdr"
      fetch() {
          request -H @"$WORK/gcp.hdr" \
              "https://secretmanager.googleapis.com/v1/projects/${project_id}/secrets/$1/versions/latest:access" \
              | sed -n 's/.*"data": "\([^"]*\)".*/\1/p' \
              | base64 -d
      }
      fetch "${link_ca_secret_id}" > "$WORK/link-ca.pem"
      printf 'Authorization: Bearer %s\n' "$(fetch "${credential_secret_id}")" > "$WORK/relay.hdr"

      INSTANCE_TOKEN="$(metadata "instance/service-accounts/default/identity?audience=${ziti_enroll_audience}&format=full")"
      printf '{"instance_token":"%s"}' "$INSTANCE_TOKEN" \
          | request --cacert "$WORK/link-ca.pem" -H @"$WORK/relay.hdr" \
              -H 'Content-Type: application/json' --data-binary @- \
              "${ziti_enroll_url}" > "$WORK/enrolment.json"
      sed -n 's/.*"enrollment_token":"\([^"]*\)".*/\1/p' "$WORK/enrolment.json" > "$WORK/enroll.jwt"
      rm -f "$WORK/gcp.hdr" "$WORK/relay.hdr" "$WORK/enrolment.json"
      if [ ! -s "$WORK/enroll.jwt" ]; then
          echo "the control plane returned no enrolment token" >&2
          exit 1
      fi

      chown 2171:2171 "$WORK" "$WORK/enroll.jwt"
      /usr/bin/docker run --rm --network host --user 2171:2171 \
          --volume "$WORK:/work" --entrypoint ziti ${ziti_cli_image} \
          edge enroll --jwt /work/enroll.jwt --out /work/identity.json
      install -o 2171 -g 2171 -m 0400 "$WORK/identity.json" "$DIR/identity.json"
      chown 2171:2171 "$DIR"
      rm -rf "$WORK"
      echo "enrolled on the overlay"

  - path: /etc/systemd/system/moqom-ziti.service
    permissions: "0644"
    owner: root
    content: |
      [Unit]
      Description=MOQOM overlay tunneler
      Wants=gcr-online.target docker.service
      After=gcr-online.target docker.service

      [Service]
      Type=simple
      Restart=always
      RestartSec=15
      TimeoutStartSec=10min
      # Enrolment runs before the container has a log driver, so its output
      # would otherwise be only in a journal nobody can read without SSH.
      StandardOutput=journal+console
      StandardError=journal+console
      Environment=HOME=/home/chronos
      ExecStartPre=/usr/bin/docker-credential-gcr configure-docker --registries=${registry_host}
      ExecStartPre=-/usr/bin/docker rm -f moqom-ziti
      ExecStartPre=/usr/bin/docker pull ${ziti_cli_image}
      ExecStartPre=/bin/bash /etc/moqom/ziti-enroll.sh
      # Proxy mode: a loopback listener for each service this identity may dial
      # (the control plane's), and a host for each it may bind (this relay's
      # admin port and SSH, for operators). Nothing listens beyond loopback.
      ExecStart=/usr/bin/docker run --rm --name moqom-ziti --network host --user 2171:2171 --log-driver=gcplogs --volume /var/lib/moqom-ziti:/ziti:ro --entrypoint ziti ${ziti_cli_image} tunnel proxy --identity /ziti/identity.json --svcPollRate ${ziti_poll_seconds} --cli-agent=false
      ExecStop=/usr/bin/docker stop --time=10 moqom-ziti

      [Install]
      WantedBy=multi-user.target

%{ endif ~}
  - path: /etc/systemd/system/moqom-relay.service
    permissions: "0644"
    owner: root
    content: |
      [Unit]
      Description=MOQOM relay
      Wants=gcr-online.target docker.service
      After=gcr-online.target docker.service

      [Service]
      Type=simple
      Restart=always
      RestartSec=5
      Environment=HOME=/home/chronos
      ExecStartPre=/usr/bin/docker-credential-gcr configure-docker --registries=${registry_host}
      ExecStartPre=-/usr/bin/docker rm -f moqom-relay
      # Re-fetched on every start, so a rotated secret needs a restart and not a
      # new instance template.
      # Through the interpreter rather than executed directly, so the mount
      # options on the filesystem holding it cannot matter.
      ExecStartPre=/bin/bash /etc/moqom/open-ports.sh
      ExecStartPre=/bin/bash /etc/moqom/fetch-secrets.sh
      ExecStartPre=/usr/bin/docker pull ${image}
      # Host networking, not a port mapping. Docker's userland proxy adds a hop
      # and a copy per datagram, and SO_REUSEPORT sharding across accept
      # threads — the standard way to scale a QUIC server past one core — only
      # works against the host's own stack.
      ExecStart=/usr/bin/docker run --rm --name moqom-relay \
        --network host \
        --ulimit nofile=1048576:1048576 \
        --ulimit memlock=-1:-1 \
        # gcplogs, not json-file. These machines have no external address and
        # SSH to them is a deliberate act, so logs that only exist on local disk
        # are logs nobody reads -- and a relay that crashes on startup takes its
        # only explanation with it. The cost is that `docker logs` on the
        # instance returns nothing; the daemon streams straight to Cloud
        # Logging instead.
        --log-driver=gcplogs \
        --log-opt gcp-log-cmd=true \
        --volume /run/moqom/tls:/etc/moqom/tls:ro \
        --env-file /run/moqom/relay.env \
        --env MOQOM_RELAY_ADDR=0.0.0.0:${udp_port} \
        --env MOQOM_RELAY_ADMIN_ADDR=0.0.0.0:${health_check_port} \
        --env MOQOM_RELAY_ADMIN_AUTH=probes-only \
%{ if stun_port != "" ~}
        --env MOQOM_RELAY_STUN_ADDR=0.0.0.0:${stun_port} \
%{ else ~}
        --env MOQOM_RELAY_STUN_ADDR=off \
%{ endif ~}
%{ if ziti_enabled ~}
        --env MOQOM_RELAY_ADMIN_LOCAL_ADDR=127.0.0.1:8082 \
%{ endif ~}
%{ if tls_certificate_secret_id != "" ~}
        --env MOQOM_RELAY_CERT=/etc/moqom/tls/cert.pem \
        --env MOQOM_RELAY_KEY=/etc/moqom/tls/key.pem \
%{ endif ~}
%{ if link_ca_secret_id != "" ~}
        --volume /run/moqom/link:/etc/moqom/link:ro \
        --env MOQOM_CONTROL_CA=/etc/moqom/link/ca.pem \
        --env MOQOM_CONTROL_CLIENT_CERT=/etc/moqom/link/cert.pem \
        --env MOQOM_CONTROL_CLIENT_KEY=/etc/moqom/link/key.pem \
%{ endif ~}
%{ if ticket_keys_secret_id != "" ~}
        --volume /run/moqom/tickets:/etc/moqom/tickets:ro \
        --env MOQOM_RELAY_TICKET_KEYS=/etc/moqom/tickets/keys.json \
%{ endif ~}
%{ for key, value in container_env ~}
        --env ${key}=${value} \
%{ endfor ~}
        ${image}
      # SIGTERM means drain: stop answering the serving health check, refuse new
      # sessions, send GOAWAY, and let the ones in flight finish. The relay is
      # responsible for that sequence; systemd only bounds how long it waits.
      ExecStop=/usr/bin/docker stop --time=${stop_timeout_sec} moqom-relay
      TimeoutStopSec=${stop_timeout_sec + 15}
      KillSignal=SIGTERM

      [Install]
      WantedBy=multi-user.target

runcmd:
  - sysctl --system
  # Before the relay starts, so that the first sessions it accepts are stamped
  # with a clock somebody has vouched for. chrony is asked to wait for a source
  # rather than assumed to have found one; the relay reports
  # `moqom_relay_clock_synchronised 0` if this did not work, which is the check
  # that actually matters and the one an operator should alarm on.
  - systemctl restart chronyd
  - chronyc waitsync 12 0.1 || echo "chrony did not reach time.cloudflare.com; timecodes will fall back to local time"
  - systemctl daemon-reload
  - systemctl enable --now moqom-relay.service
%{ if ziti_enabled ~}
  # Not waited for: the relay serves without the overlay, and boot should not
  # stall on it.
  - systemctl enable --now --no-block moqom-ziti.service
%{ endif ~}
