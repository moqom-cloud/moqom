#cloud-config

write_files:
  - path: /etc/sysctl.d/60-moqom-relay.conf
    permissions: "0644"
    owner: root
    content: |
      # QUIC does its loss recovery, pacing, and congestion control in
      # userspace, so the kernel's only job on the receive path is to not lose
      # datagrams between the NIC and the socket. The Container-Optimized OS
      # defaults are sized for a handful of TCP flows; a relay handles small
      # packets at a high rate from thousands of peers, and the first symptom of
      # an undersized receive buffer is packet loss that the sender interprets
      # as congestion and responds to by sending less.
      net.core.rmem_max = 33554432
      net.core.wmem_max = 33554432
      net.core.rmem_default = 8388608
      net.core.wmem_default = 8388608
      net.core.netdev_max_backlog = 65536
      net.core.somaxconn = 8192

      # UDP memory accounting in pages, not bytes.
      net.ipv4.udp_mem = 262144 524288 1048576
      net.ipv4.udp_rmem_min = 262144
      net.ipv4.udp_wmem_min = 262144

  - path: /etc/chrony/chrony.conf
    permissions: "0644"
    owner: root
    content: |
      # Replaces the Container-Optimized OS default wholesale, and the word
      # "replaces" is the point rather than an implementation detail.
      #
      # COS ships `server metadata.google.internal prefer iburst`, and Google's
      # metadata clock *smears* leap seconds: it spreads the extra second across
      # a long window so that UTC never repeats. Cloudflare does not smear — it
      # forwards the leap indicator and lets the kernel step — and Cloudflare's
      # own documentation warns that mixing smeared and unsmeared sources gives
      # "unpredictable and anomalous results". Since every MOQOM client takes its
      # time from time.cloudflare.com, a relay left on the metadata server would
      # sit up to half a second away from the phones publishing to it for the
      # duration of a smear, which is far worse than the one-second
      # discontinuity the smear exists to avoid.
      #
      # So: one source family, chosen to match the clients, and the Google
      # source removed rather than deprioritised.
      pool time.cloudflare.com iburst maxsources 4

      # Step rather than slew for the first few updates, then slew forever
      # after. A relay that boots with a wildly wrong clock should correct it
      # immediately; one that has been serving for a week should never have time
      # jump underneath an in-flight recording.
      makestep 1.0 3

      # Never smear. This is chrony's default, and it is written down because
      # the alternative — `leapsecmode slew` — would silently reintroduce
      # exactly the mismatch this file exists to remove.
      #
      # Worth being explicit that not smearing is the *better* choice here and
      # not merely the consistent one, because the usual advice says otherwise.
      # Smearing keeps the wall clock continuous, which protects code that
      # computes durations from it; every famous leap-second outage was a
      # negative duration. MOQOM has no such code — every duration in the relay,
      # the control plane and the SDKs comes from a monotonic clock, never from
      # this one — so smearing would buy protection we do not need.
      #
      # What it would cost is the thing we cannot give up. A smearing host is
      # knowingly up to half a second from UTC for around twenty-four hours,
      # and the kernel reports a healthy few-millisecond error bound throughout,
      # so the relay would publish confident timecodes that are wrong by 500ms
      # with nothing anywhere to indicate it. Not smearing gives a one-second
      # window instead of a day-long one, and it announces itself in advance via
      # the leap indicator, which the relay turns into a ±1s uncertainty on
      # every timecode for the rest of that day. Honest and short beats silent
      # and long, for a system whose whole premise is the error bound.
      leapsecmode system

      # Refuse a source whose own root distance is worse than this. The relay
      # publishes the kernel's error bound as the uncertainty on every timecode
      # it writes, so a source that cannot say where it is within a quarter
      # second is worse than no source: it would produce confident-looking
      # readings with no basis.
      maxdistance 0.25

      driftfile /var/lib/chrony/drift
      rtcsync
      logdir /var/log/chrony

  - path: /etc/systemd/system/moqom-relay.service
    permissions: "0644"
    owner: root
    content: |
      [Unit]
      Description=MOQOM relay
      Wants=gcr-online.target docker.service
      After=gcr-online.target docker.service

      [Service]
      Type=simple
      Restart=always
      RestartSec=5
      Environment=HOME=/home/chronos
      ExecStartPre=/usr/bin/docker-credential-gcr configure-docker --registries=${registry_host}
      ExecStartPre=-/usr/bin/docker rm -f moqom-relay
      # Host networking, not a port mapping. Docker's userland proxy adds a hop
      # and a copy per datagram, and SO_REUSEPORT sharding across accept
      # threads — the standard way to scale a QUIC server past one core — only
      # works against the host's own stack.
      ExecStart=/usr/bin/docker run --rm --name moqom-relay \
        --network host \
        --ulimit nofile=1048576:1048576 \
        --ulimit memlock=-1:-1 \
        --log-driver=json-file --log-opt max-size=64m --log-opt max-file=3 \
        --env MOQOM_RELAY_UDP_PORT=${udp_port} \
        --env MOQOM_RELAY_HEALTH_PORT=${health_check_port} \
%{ for key, value in container_env ~}
        --env ${key}=${value} \
%{ endfor ~}
        ${image}
      # SIGTERM means drain: stop answering the serving health check, refuse new
      # sessions, send GOAWAY, and let the ones in flight finish. The relay is
      # responsible for that sequence; systemd only bounds how long it waits.
      ExecStop=/usr/bin/docker stop --time=${stop_timeout_sec} moqom-relay
      TimeoutStopSec=${stop_timeout_sec + 15}
      KillSignal=SIGTERM

      [Install]
      WantedBy=multi-user.target

runcmd:
  - sysctl --system
  # Before the relay starts, so that the first sessions it accepts are stamped
  # with a clock somebody has vouched for. chrony is asked to wait for a source
  # rather than assumed to have found one; the relay reports
  # `moqom_relay_clock_synchronised 0` if this did not work, which is the check
  # that actually matters and the one an operator should alarm on.
  - systemctl restart chronyd
  - chronyc waitsync 12 0.1 || echo "chrony did not reach time.cloudflare.com; timecodes will fall back to local time"
  - systemctl daemon-reload
  - systemctl enable --now moqom-relay.service
