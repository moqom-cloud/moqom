variable "project_id" {
  type        = string
  description = "Project the overlay runs in."
}

variable "region" {
  type        = string
  description = "Region of the VM, its addresses and its state disk."
}

variable "zone" {
  type        = string
  description = "Zone of the VM and its state disk. A zonal disk is what holds the controller's database, so the VM cannot move zones without a snapshot restore."
}

variable "name_prefix" {
  type        = string
  description = "Prefix for every resource name, e.g. moqom-dev."
}

variable "network" {
  type        = string
  description = "VPC self link or id."
}

variable "subnetwork" {
  type        = string
  description = "Subnet the VM's interface is in. Must be in var.region."
}

variable "network_tag" {
  type        = string
  description = "Network tag on the VM. Every firewall rule this module creates targets it."
  default     = "moqom-ziti"
}

variable "machine_type" {
  type        = string
  description = "The controller and one edge router together need well under a gigabyte at this size of network. e2-small is the smallest shape that leaves room for the Cloud SQL proxy beside them."
  default     = "e2-small"
}

variable "boot_image" {
  type        = string
  description = "Container-Optimized OS, the same family as the relays, so one set of host quirks is known."
  default     = "projects/cos-cloud/global/images/family/cos-121-lts"
}

variable "state_disk_size_gb" {
  type        = number
  description = "Size of the disk that holds the controller's raft database and PKI and the router's identity."
  default     = 10
}

variable "snapshot_retention_days" {
  type        = number
  description = "Daily snapshots of the state disk are kept this long. The disk is the only copy of the identities and policies; the PKI is also backed up to Secret Manager."
  default     = 7
}

variable "controller_image" {
  type        = string
  description = "openziti/ziti-controller, pinned by digest."
}

variable "router_image" {
  type        = string
  description = "openziti/ziti-router, pinned by digest."
}

variable "registry_host" {
  type        = string
  description = "Registry host the images are pulled from, for docker-credential-gcr. Null when the images are public."
  default     = null
}

variable "artifact_registry_repository" {
  type = object({
    project_id = string
    location   = string
    repository = string
  })
  description = "Repository the VM may pull from, or null."
  default     = null
}

variable "controller_port" {
  type        = number
  description = "Client API, enrolment and the router control channel. Reached by every identity, so it is public."
  default     = 1280
}

variable "management_port" {
  type        = number
  description = "Management API and fabric API, on a web listener of their own so they can be closed to the internet."
  default     = 1281
}

variable "router_port" {
  type        = number
  description = "The edge router's listener. Every SDK and tunneler connects here; public."
  default     = 3022
}

variable "management_source_ranges" {
  type        = list(string)
  description = "Who may reach the management port: the cluster's pods (the control plane mints identities) and IAP TCP forwarding (an operator's provisioning run)."
  default     = []
}

variable "enable_iap_ssh" {
  type        = bool
  description = "Allow SSH to the VM from IAP's range, for bring-up and incident work."
  default     = true
}

variable "admin_password_secret_id" {
  type        = string
  description = "Secret Manager id holding the controller's default admin password. Generated by the VM at first boot when empty."
}

variable "pki_backup_secret_id" {
  type        = string
  description = "Secret Manager id the VM backs up the controller's PKI to after first boot, and restores it from onto an empty disk."
}

variable "sql_instance_connection_name" {
  type        = string
  description = "Cloud SQL instance to expose to operators as a dark service through the Cloud SQL proxy on this VM. Null for none."
  default     = null
}

variable "sql_proxy_image" {
  type        = string
  description = "The Cloud SQL Auth Proxy image, pinned by digest."
  default     = "gcr.io/cloud-sql-connectors/cloud-sql-proxy:2.26.0@sha256:86e4f3cc266020e7ee07740df78d7511e2c340c274b56f84d80b7251913af9ad"
}

variable "sql_proxy_port" {
  type        = number
  description = "Loopback port the proxy listens on, which the router's tunneler forwards the Postgres service to."
  default     = 5432
}

variable "router_name" {
  type        = string
  description = "Name of the edge router, which is also the name of its tunneler identity. Defaults to <name_prefix>-router-1."
  default     = null
}

variable "labels" {
  type    = map(string)
  default = {}
}
