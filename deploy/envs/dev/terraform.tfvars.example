project_id = "moqom-dev"
region     = "us-central1"

# Tags are fine in dev. Prod pins digests; see the comment on the relay module's
# `image` variable for why.
relay_image    = "us-docker.pkg.dev/moqom-dev/moqom-dev/moqom-relay:latest"
control_image  = "us-docker.pkg.dev/moqom-dev/moqom-dev/moqom-control:latest"
director_image = "us-docker.pkg.dev/moqom-dev/moqom-dev/moqom-director:latest"

dns_domain = "dev.moqom.cloud."

# Globally unique across all of GCP, not just this project. Add a suffix if it
# collides with something unrelated.
recording_bucket_name = "moqom-dev-recordings"

# The org, not the repository owner you might guess from the product name.
github_owner        = "moqom-cloud"
github_repositories = ["moqom-cloud/moqom"]

notification_emails = ["elliott@moqom.cloud"]
