# The sample app's token server, built from the same context as the control
# plane image: the parent directory holding moqom, moqom-go and moqom-security.

FROM golang:1.27-bookworm AS build

WORKDIR /src

COPY moqom/go/go.mod moqom/go/go.sum ./moqom/go/
COPY moqom-go/go.mod moqom-go/go.sum ./moqom-go/
COPY moqom-security/go ./moqom-security/go
RUN cd moqom/go && GOWORK=off go mod download

COPY moqom-go ./moqom-go
COPY moqom/go ./moqom/go

RUN cd moqom/go && \
    GOWORK=off CGO_ENABLED=0 GOOS=linux \
    go build -trimpath -ldflags="-s -w" -o /out/ ./cmd/moqom-sample-tokens

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=build /out/moqom-sample-tokens /moqom-sample-tokens

EXPOSE 8080

USER nonroot:nonroot
ENTRYPOINT ["/moqom-sample-tokens"]
