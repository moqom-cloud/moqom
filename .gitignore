# Rust
target/

# Fuzzing. The corpus is regenerable (`cargo run --example seed-corpus`) and CI
# caches its own, so committing it would only add churn. Crashes are not kept
# here either: anything found gets transcribed into REGRESSION_CORPUS in
# moqom-proto::testing, where it runs on stable CI instead of rotting in a
# directory nobody reads.
rs/fuzz/corpus/
rs/fuzz/artifacts/
rs/fuzz/coverage/
**/*.rs.bk
*.pdb

# Go
go/bin/
*.test
*.out

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# Apple
.DS_Store
xcuserdata/
*.xcuserstate
DerivedData/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
Pods/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# Secrets and local config
.env
.env.*
!.env.example
*.pem
*.p8
*.p12
*.mobileprovision
service-account*.json

# Editors
.idea/
*.swp
.vscode/*
!.vscode/extensions.json

# Build artifacts
*.xcframework
*.aar
*.wasm
pkg/

# Local scratch
/tmp/
/scratch/
